{% if block.settings.enable_app %}
  {{ 'custom-checkout.css' | asset_url | stylesheet_tag }}

  {% if customer %}
    <script id="artiz-logged-customer-data" type="application/json">
      {
        "id": {{ customer.id | json }},
        "name": {{ customer.name | json }},
        "firstName": {{ customer.first_name | json }},
        "lastName": {{ customer.last_name | json }},
        "email": {{ customer.email | json }},
        "phone": {{ customer.phone | default: customer.default_address.phone | json }},
        "address": {{ customer.default_address.address1 | json }},
        "city": {{ customer.default_address.city | json }},
        "country": {{ customer.default_address.country | json }}
      }
    </script>
  {% endif %}

  <div 
    id="artiz-cod-global-root" 
    data-shop="{{ shop.permanent_domain }}"
    data-currency="{{ shop.currency }}"
    data-primary-color="{{ block.settings.primary_color | default: '#008060' }}"
    data-button-text="{{ block.settings.button_text | default: 'اشتري الآن - الدفع عند الاستلام' }}"
  ></div>

  <script src="{{ 'custom-checkout.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Artiz COD Form",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_app",
      "label": "تفعيل تطبيق الدفع عند الاستلام (Enable COD App)",
      "default": true
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "لون الزر الرئيسي (Button Color)",
      "default": "#008060"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "نص زر الطلب السريع (Button Text)",
      "default": "اشتري الآن - الدفع عند الاستلام"
    }
  ]
}
{% endschema %}
